<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#1a0e00">
    <title>Pantau <%= room.name %> - ADMIN - RICO FT</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="chat-page">
    <div class="chat-container">
        <!-- Chat Header -->
        <div class="chat-header">
            <a href="/admin" class="btn btn-sm btn-outline">← Admin</a>
            <div class="chat-room-info">
                <h3>👁 PANTUAN ADMIN — <%= room.name %></h3>
                <span>fee <%= formatRupiah(room.fee) %> | pp <%= formatRupiah(room.pp) %></span>
                <span class="chat-slot"><%= room.players.length %>/4 pemain</span>
                <% if (room.inProgress) { %>
                    <span class="chat-status playing">🔴 BERMAIN</span>
                <% } %>
            </div>
        </div>

        <!-- Chat Messages -->
        <div class="chat-messages" id="chatMessages">
            <% if (messages.length === 0) { %>
                <div class="chat-empty">Belum ada pesan di room ini.</div>
            <% } %>
            <% messages.forEach(msg => { %>
                <% if (msg.isSystem) { %>
                    <div class="chat-bubble chat-system" data-msg-id="<%= msg.id %>">
                        <div class="chat-sender system-sender"><%= msg.from %></div>
                        <% if (msg.image) { %>
                            <div class="chat-image">
                                <img src="/uploads/<%= msg.image %>" alt="foto" onclick="window.open(this.src)">
                            </div>
                        <% } %>
                        <% if (msg.text) { %>
                            <div class="chat-text system-text"><%- formatMessageText(msg.text, []).replace(/\n/g, '<br>').replace(/\*(.*?)\*/g, '<strong>$1</strong>') %></div>
                        <% } %>
                        <div class="chat-time"><%= new Date(msg.time).toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'}) %></div>
                    </div>
                <% } else { %>
                    <div class="chat-bubble other" data-msg-id="<%= msg.id %>" data-from="<%= msg.from %>">
                        <div class="chat-sender"><%= msg.from %></div>
                        <% if (msg.image) { %>
                            <div class="chat-image">
                                <img src="/uploads/<%= msg.image %>" alt="foto" onclick="window.open(this.src)">
                            </div>
                        <% } %>
                        <% if (msg.text) { %>
                            <div class="chat-text"><%- formatMessageText(msg.text, playerNames) %></div>
                        <% } %>
                        <div class="chat-meta">
                            <span class="chat-time"><%= new Date(msg.time).toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'}) %></span>
                        </div>
                    </div>
                <% } %>
            <% }) %>
        </div>

        <!-- Admin Input -->
        <div class="chat-input-area">
            <div class="chat-identity">💬 Kamu: <strong>👮 Admin</strong></div>
            <form class="chat-form" id="chatForm">
                <input type="text" id="chatInput" placeholder="Ketik pesan sebagai Admin..." autocomplete="off" maxlength="500">
                <button type="submit" class="btn btn-send">Kirim</button>
            </form>
            <label class="broadcast-toggle">
                <input type="checkbox" id="broadcastAll">
                📢 Broadcast ke semua room yang sedang bermain
            </label>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io({ auth: { adminKey: '<%= adminKey %>' } });
        const roomId = '<%= room.id %>';
        const roomPlayers = <%- JSON.stringify(playerNames).replace(/</g, '\\u003c') %>;
        const chatForm = document.getElementById('chatForm');
        const chatInput = document.getElementById('chatInput');
        const chatMessages = document.getElementById('chatMessages');
        const broadcastAll = document.getElementById('broadcastAll');

        // Join room
        socket.emit('join-room', roomId);

        // Send message (per room or global broadcast)
        chatForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const text = chatInput.value.trim();
            if (!text) return;

            if (broadcastAll.checked) {
                socket.emit('admin-broadcast', { text });
            } else {
                socket.emit('admin-message', { roomId, text });
            }
            chatInput.value = '';
        });

        // Receive message
        socket.on('new-message', (msg) => {
            const div = document.createElement('div');
            div.className = msg.isSystem ? 'chat-bubble chat-system' : 'chat-bubble other';
            div.dataset.msgId = msg.id;
            if (!msg.isSystem) div.dataset.from = msg.from;

            let html = `<div class="chat-sender ${msg.isSystem ? 'system-sender' : ''}">${escHtml(msg.from)}</div>`;
            if (msg.image) {
                html += `<div class="chat-image"><img src="/uploads/${msg.image}" alt="foto" onclick="window.open(this.src)"></div>`;
            }
            if (msg.text) {
                if (msg.isSystem) {
                    const formatted = formatChatText(msg.text).replace(/\n/g, '<br>').replace(/\*(.*?)\*/g, '<strong>$1</strong>');
                    html += `<div class="chat-text system-text">${formatted}</div>`;
                } else {
                    html += `<div class="chat-text">${formatChatText(msg.text)}</div>`;
                }
            }
            if (msg.isSystem) {
                const time = new Date(msg.time).toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'});
                html += `<div class="chat-time">${time}</div>`;
            } else {
                html += `<div class="chat-meta">`;
                const time = new Date(msg.time).toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'});
                html += `<span class="chat-time">${time}</span>`;
                html += `</div>`;
            }

            div.innerHTML = html;
            chatMessages.appendChild(div);
            chatMessages.scrollTop = chatMessages.scrollHeight;

            if (msg.isSystem && msg.from === '🏆 POT') {
                showToast('🏆 Match Pairing sudah ditentukan!');
            }
            if (msg.from === '👮 Admin') {
                showToast('📢 Pesan admin terkirim');
            }
        });

        // Mention formatting (escape + highlight @Nama)
        function escHtml(s) {
            return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        function formatChatText(text) {
            let out = escHtml(text);
            const names = roomPlayers.slice().sort((a, b) => b.length - a.length);
            for (const n of names) {
                const escName = escHtml(n);
                const re = new RegExp('@' + escName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
                out = out.replace(re, '<span class="mention">@' + escName + '</span>');
            }
            return out;
        }

        // Pairing notification
        socket.on('pairing-notification', (data) => {
            showToast('🏆 P1: ' + data.p1 + ' vs ' + data.p2 + ' | P2: ' + data.p3 + ' vs ' + data.p4);
        });

        // Winner notification
        socket.on('winner-notification', (data) => {
            showToast('🏆 ' + data.winnerName + ' menang! Saldo +Rp ' + data.amount.toLocaleString('id-ID'));
        });

        function showToast(msg) {
            let t = document.querySelector('.toast');
            if (!t) {
                t = document.createElement('div');
                t.className = 'toast';
                document.body.appendChild(t);
            }
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3000);
        }

        // Scroll to bottom
        chatMessages.scrollTop = chatMessages.scrollHeight;
    </script>
</body>
</html>