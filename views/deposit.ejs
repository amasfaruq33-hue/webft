<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deposit - RICO FT</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .qris-image {
            width: 100%;
            max-width: 280px;
            border-radius: 14px;
            border: 2px solid rgba(255, 255, 255, 0.1);
            margin: 12px auto;
            display: block;
            cursor: pointer;
            transition: transform 0.3s;
        }
        .qris-image:hover {
            transform: scale(1.03);
        }
        .qris-label {
            text-align: center;
            font-size: 12px;
            color: #888;
            margin-bottom: 16px;
        }
    </style>
</head>
<body class="auth-page">
    <div class="auth-container">
        <div class="auth-logo">💰</div>
        <h1>DEPOSIT</h1>
        <p class="auth-subtitle">Transfer ke admin, kirim bukti disini</p>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <div class="info-box">
            <p><strong>Transfer ke salah satu:</strong></p>
            <p>📱 DANA: 087847468523</p>
        </div>

        <img src="/qris.jpg" alt="QRIS" class="qris-image" onclick="window.open(this.src)">
        <p class="qris-label">Klik gambar untuk zoom</p>

        <form method="POST" action="/deposit" enctype="multipart/form-data">
            <div class="form-group">
                <label>Nominal Deposit</label>
                <input type="number" name="nominal" placeholder="Minimal Rp 1.000" required min="1000">
            </div>
            <div class="form-group">
                <label>Bukti Transfer</label>
                <input type="file" name="bukti" accept="image/*" required>
            </div>
            <button type="submit" class="btn btn-primary btn-full">KIRIM DEPOSIT</button>
        </form>

        <p class="auth-link"><a href="/dashboard">← Kembali ke Dashboard</a></p>
    </div>
</body>
</html>
